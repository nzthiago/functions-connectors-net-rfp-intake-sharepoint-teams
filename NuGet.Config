<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="ConnectorExtension_PublicPackages" value="https://pkgs.dev.azure.com/azfunc/public/_packaging/ConnectorExtension_PublicPackages/nuget/v3/index.json" />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ConnectorExtension_PublicPackages">
      <package pattern="Microsoft.Azure.Functions.Worker.Extensions.Connector" />
    </packageSource>
    <packageSource key="azure-default">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
